<Application x:Class="Blackjack.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#CC11281E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E7B75B" />

        <Style TargetType="Button">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFF7E8" />
            <Setter Property="Background" Value="#234D3B" />
            <Setter Property="BorderBrush" Value="#5B8B72" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="StatLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Margin" Value="0,7" />
            <Setter Property="Foreground" Value="#A9C4B5" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="StatValueStyle"
               TargetType="TextBlock">
            <Setter Property="Margin" Value="18,7,0,7" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Resources>
</Application>
