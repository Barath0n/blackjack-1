<Window x:Class="Blackjack.App.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statistik"
        Width="930"
        Height="690"
        MinWidth="850"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#071A12">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="STATISTIK"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock x:Name="SessionStartedText"
                           Margin="0,5,0,0"
                           Foreground="#A9C4B5"
                           FontSize="13" />
            </StackPanel>

            <TextBlock x:Name="CurrentBankrollText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold" />
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="18" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="22"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock Text="AKTUELLE SESSION"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="17"
                               FontWeight="Bold" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Runden" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="SessionRoundsText" Grid.Row="0" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="1" Text="Hände" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="SessionHandsText" Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="2" Text="Gewonnen" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="SessionWinsText" Grid.Row="2" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="3" Text="Verloren" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="SessionLossesText" Grid.Row="3" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="4" Text="Unentschieden" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="SessionPushesText" Grid.Row="4" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="5" Text="Blackjacks" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="SessionBlackjacksText" Grid.Row="5" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="6" Text="Aufgegeben" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="SessionSurrendersText" Grid.Row="6" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="7" Text="Gewinnquote" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="SessionWinRateText" Grid.Row="7" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="8" Text="Gesamteinsatz" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="SessionWageredText" Grid.Row="8" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="9" Text="Bilanz" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="SessionProfitText" Grid.Row="9" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="10" Text="Größter Rundengewinn" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="SessionBiggestWinText" Grid.Row="10" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="11" Text="Größter Rundenverlust" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="SessionBiggestLossText" Grid.Row="11" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="12" Text="Höchstes Guthaben" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="SessionHighestBankrollText" Grid.Row="12" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="22"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock Text="GESAMT"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="17"
                               FontWeight="Bold" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Runden" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="LifetimeRoundsText" Grid.Row="0" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="1" Text="Hände" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="LifetimeHandsText" Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="2" Text="Gewonnen" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="LifetimeWinsText" Grid.Row="2" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="3" Text="Verloren" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="LifetimeLossesText" Grid.Row="3" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="4" Text="Unentschieden" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="LifetimePushesText" Grid.Row="4" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="5" Text="Blackjacks" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="LifetimeBlackjacksText" Grid.Row="5" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="6" Text="Aufgegeben" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="LifetimeSurrendersText" Grid.Row="6" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="7" Text="Gewinnquote" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="LifetimeWinRateText" Grid.Row="7" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="8" Text="Gesamteinsatz" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="LifetimeWageredText" Grid.Row="8" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="9" Text="Bilanz" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="LifetimeProfitText" Grid.Row="9" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="10" Text="Größter Rundengewinn" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="LifetimeBiggestWinText" Grid.Row="10" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="11" Text="Größter Rundenverlust" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="LifetimeBiggestLossText" Grid.Row="11" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Grid.Row="12" Text="Höchstes Guthaben" Style="{StaticResource StatLabelStyle}" />
                        <TextBlock x:Name="LifetimeHighestBankrollText" Grid.Row="12" Grid.Column="1" Style="{StaticResource StatValueStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal">
                <Button Content="Session-Statistik löschen"
                        Click="ResetSessionStatisticsButton_Click" />
                <Button Content="Gesamtstatistik löschen"
                        Click="ResetLifetimeStatisticsButton_Click" />
            </StackPanel>

            <Button HorizontalAlignment="Right"
                    Content="Schließen"
                    Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
