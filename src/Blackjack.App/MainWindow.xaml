<Window x:Class="Blackjack.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blackjack Remastered"
        Width="1180"
        Height="760"
        MinWidth="920"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#071A12">
    <Window.Resources>
        <DataTemplate x:Key="CardTemplate">
            <Border Width="92"
                    Height="132"
                    Margin="7"
                    CornerRadius="10"
                    Background="#FFF9EE"
                    BorderBrush="#E2D7C4"
                    BorderThickness="2">
                <TextBlock Text="{Binding}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Symbol"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#161616" />
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18"
                Background="{StaticResource PanelBrush}"
                CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="BLACKJACK REMASTERED"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="25"
                               FontWeight="Bold" />
                    <TextBlock Text="2012 → 2026"
                               Margin="0,3,0,0"
                               Foreground="#A9C4B5"
                               FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Guthaben "
                               Foreground="#A9C4B5"
                               FontSize="16" />
                    <TextBlock x:Name="BankrollText"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold" />
                    <TextBlock Text="   Einsatz "
                               Foreground="#A9C4B5"
                               FontSize="16" />
                    <TextBlock x:Name="CurrentBetText"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,18"
                Padding="22"
                CornerRadius="26"
                BorderBrush="#376B53"
                BorderThickness="2">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.35"
                                     GradientOrigin="0.5,0.35"
                                     RadiusX="0.85"
                                     RadiusY="0.85">
                    <GradientStop Color="#24563F" Offset="0" />
                    <GradientStop Color="#0C2B1D" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
    		    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="DEALER"
                               HorizontalAlignment="Center"
                               Foreground="#BBD4C6"
                               FontSize="14"
                               FontWeight="Bold" />
                    <ItemsControl x:Name="DealerCards"
                                  Margin="0,8,0,0"
                                  HorizontalAlignment="Center"
                                  ItemTemplate="{StaticResource CardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock x:Name="DealerScoreText"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="110,18"
                        Padding="18,10"
                        VerticalAlignment="Center"
                        Background="#AA071A12"
                        CornerRadius="12">
                    <TextBlock x:Name="StatusText"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                </Border>

                <StackPanel Grid.Row="2"
                            VerticalAlignment="Bottom">
                    <TextBlock Text="SPIELER"
                               HorizontalAlignment="Center"
                               Foreground="#BBD4C6"
                               FontSize="14"
                               FontWeight="Bold" />
                    <ItemsControl x:Name="PlayerCards"
                                  Margin="0,8,0,0"
                                  HorizontalAlignment="Center"
                                  ItemTemplate="{StaticResource CardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock x:Name="PlayerScoreText"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="12"
                Background="{StaticResource PanelBrush}"
                CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Einsatz:"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               Foreground="#A9C4B5"
                               FontSize="15" />
	            <ComboBox x:Name="BetSelector"
                              Width="95"
                              Height="42"
                              Margin="0,0,6,0"
                              Padding="8,0"
                              VerticalContentAlignment="Center"
                              SelectedIndex="2"
                              FontSize="15">
                        <ComboBoxItem Content="5 €" Tag="5" />
                        <ComboBoxItem Content="10 €" Tag="10" />
                        <ComboBoxItem Content="25 €" Tag="25" />
                        <ComboBoxItem Content="50 €" Tag="50" />
                        <ComboBoxItem Content="100 €" Tag="100" />
                    </ComboBox>
                    <Button x:Name="DealButton"
                            Content="Austeilen"
                            Click="DealButton_Click" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button x:Name="HitButton"
                            Content="Karte"
                            Click="HitButton_Click" />
                    <Button x:Name="StandButton"
                            Content="Halten"
                            Click="StandButton_Click" />
                    <Button x:Name="DoubleButton"
                            Content="Verdoppeln"
                            Click="DoubleButton_Click" />
                    <Button x:Name="SurrenderButton"
                            Content="Aufgeben"
                            Click="SurrenderButton_Click" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Session zurücksetzen"
                        Click="ResetButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
