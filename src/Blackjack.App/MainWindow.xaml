<Window x:Class="Blackjack.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blackjack Remastered"
        Width="1180"
        Height="900"
        MinWidth="1100"
        MinHeight="890"
        WindowStartupLocation="CenterScreen"
        Background="#071A12">
    <Window.Resources>
        <DataTemplate x:Key="CardTemplate">
            <Border Width="96"
                    Height="136"
                    Margin="7"
                    CornerRadius="11"
                    Background="#FFF9EE"
                    BorderBrush="#D8CBB7"
                    BorderThickness="2"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="9"
                                      Direction="270"
                                      Opacity="0.28"
                                      ShadowDepth="3" />
                </Border.Effect>

                <Grid>
                    <Grid Visibility="{Binding FrontVisibility}">
                        <Grid Margin="8">
                            <StackPanel HorizontalAlignment="Left"
                                        VerticalAlignment="Top">
                                <TextBlock Text="{Binding Rank}"
                                           FontFamily="Georgia"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{Binding Foreground}" />
                                <TextBlock Text="{Binding Suit}"
                                           Margin="0,-4,0,0"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="19"
                                           Foreground="{Binding Foreground}" />
                            </StackPanel>

                            <TextBlock Text="{Binding Suit}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="43"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground}" />

                            <StackPanel HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <RotateTransform Angle="180" />
                                </StackPanel.RenderTransform>

                                <TextBlock Text="{Binding Rank}"
                                           FontFamily="Georgia"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{Binding Foreground}" />
                                <TextBlock Text="{Binding Suit}"
                                           Margin="0,-4,0,0"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="19"
                                           Foreground="{Binding Foreground}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Visibility="{Binding BackVisibility}"
                          Margin="5">
                        <Border CornerRadius="7"
                                Background="#183B5A"
                                BorderBrush="#D7B75B"
                                BorderThickness="2">
                            <Grid Margin="5">
                                <Border CornerRadius="4"
                                        BorderBrush="#8FB4CC"
                                        BorderThickness="1" />

                                <TextBlock Text="◆  ◆  ◆&#x0a;  ◆  ◆&#x0a;◆  ◆  ◆"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="15"
                                           Foreground="#D7E4EC"
                                           LineHeight="19" />

                                <Border Margin="10"
                                        CornerRadius="3"
                                        BorderBrush="#D7B75B"
                                        BorderThickness="1" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18"
                Background="{StaticResource PanelBrush}"
                CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="BLACKJACK REMASTERED"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="25"
                               FontWeight="Bold" />
                    <TextBlock Text="2012 → 2026"
                               Margin="0,3,0,0"
                               Foreground="#A9C4B5"
                               FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Guthaben "
                               Foreground="#A9C4B5"
                               FontSize="16" />
                    <TextBlock x:Name="BankrollText"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold" />
                    <TextBlock x:Name="CurrentBetLabel"
                               Text="   Einsatz "
                               Foreground="#A9C4B5"
                               FontSize="16" />
                    <TextBlock x:Name="CurrentBetText"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,18"
                Padding="22"
                CornerRadius="26"
                BorderBrush="#376B53"
                BorderThickness="2">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.35"
                                     GradientOrigin="0.5,0.35"
                                     RadiusX="0.85"
                                     RadiusY="0.85">
                    <GradientStop Color="#24563F" Offset="0" />
                    <GradientStop Color="#0C2B1D" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="DEALER"
                               HorizontalAlignment="Center"
                               Foreground="#BBD4C6"
                               FontSize="14"
                               FontWeight="Bold" />
                    <ItemsControl x:Name="DealerCards"
                                  Margin="0,8,0,0"
                                  HorizontalAlignment="Center"
                                  ItemTemplate="{StaticResource CardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock x:Name="DealerScoreText"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold" />
                </StackPanel>

                <Border x:Name="StatusBorder"
                        Grid.Row="2"
                        Margin="110,18"
                        Padding="18,10"
                        VerticalAlignment="Center"
                        Background="#AA071A12"
                        BorderThickness="0"
                        CornerRadius="12"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="StatusScale"
                                        ScaleX="1"
                                        ScaleY="1" />
                    </Border.RenderTransform>

                    <TextBlock x:Name="StatusText"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                </Border>

                <Grid x:Name="PlayerHandsGrid"
                      Grid.Row="4"
                      VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="PlayerHand1Border"
                            Grid.Column="0"
                            Margin="6"
                            Padding="8"
                            Background="#22071A12"
                            BorderBrush="#376B53"
                            BorderThickness="1"
                            CornerRadius="16">
                        <StackPanel>
                            <TextBlock x:Name="PlayerHand1Title"
                                       Text="SPIELER"
                                       HorizontalAlignment="Center"
                                       Foreground="#BBD4C6"
                                       FontSize="14"
                                       FontWeight="Bold" />
                            <ItemsControl x:Name="PlayerCards1"
                                          Margin="0,8,0,0"
                                          HorizontalAlignment="Center"
                                          ItemTemplate="{StaticResource CardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="PlayerScore1Text"
                                       HorizontalAlignment="Center"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="PlayerBet1Text"
                                       Margin="0,3,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="#A9C4B5"
                                       FontSize="14" />
                            <TextBlock x:Name="PlayerResult1Text"
                                       Margin="0,3,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="PlayerHand2Border"
                            Grid.Column="1"
                            Margin="6"
                            Padding="8"
                            Background="#22071A12"
                            BorderBrush="#376B53"
                            BorderThickness="1"
                            CornerRadius="16"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="PlayerHand2Title"
                                       Text="HAND 2"
                                       HorizontalAlignment="Center"
                                       Foreground="#BBD4C6"
                                       FontSize="14"
                                       FontWeight="Bold" />
                            <ItemsControl x:Name="PlayerCards2"
                                          Margin="0,8,0,0"
                                          HorizontalAlignment="Center"
                                          ItemTemplate="{StaticResource CardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="PlayerScore2Text"
                                       HorizontalAlignment="Center"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="PlayerBet2Text"
                                       Margin="0,3,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="#A9C4B5"
                                       FontSize="14" />
                            <TextBlock x:Name="PlayerResult2Text"
                                       Margin="0,3,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="12"
                Background="{StaticResource PanelBrush}"
                CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Einsatz:"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               Foreground="#A9C4B5"
                               FontSize="15" />
                    <ComboBox x:Name="BetSelector"
                              Width="95"
                              Height="42"
                              Margin="0,0,6,0"
                              Padding="8,0"
                              VerticalContentAlignment="Center"
                              SelectedIndex="2"
                              FontSize="15">
                        <ComboBoxItem Content="5 €" Tag="5" />
                        <ComboBoxItem Content="10 €" Tag="10" />
                        <ComboBoxItem Content="25 €" Tag="25" />
                        <ComboBoxItem Content="50 €" Tag="50" />
                        <ComboBoxItem Content="100 €" Tag="100" />
                    </ComboBox>
                    <Button x:Name="DealButton"
                            Content="Austeilen"
                            Click="DealButton_Click" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button x:Name="HitButton"
                            Content="Karte"
                            Click="HitButton_Click" />
                    <Button x:Name="StandButton"
                            Content="Halten"
                            Click="StandButton_Click" />
                    <Button x:Name="DoubleButton"
                            Content="Verdoppeln"
                            Click="DoubleButton_Click" />
                    <Button x:Name="SplitButton"
                            Content="Teilen"
                            Click="SplitButton_Click" />
                    <Button x:Name="SurrenderButton"
                            Content="Aufgeben"
                            Click="SurrenderButton_Click" />
                </StackPanel>

                <Button x:Name="ResetButton"
                        Grid.Column="2"
                        Content="Session zurücksetzen"
                        Click="ResetButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
