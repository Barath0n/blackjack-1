<Window x:Class="Blackjack.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Width="560"
        Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#071A12">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="TISCHEINSTELLUNGEN"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="24"
                       FontWeight="Bold" />
            <TextBlock Text="Änderungen starten eine neue Spielsitzung. Die Gesamtstatistik bleibt erhalten."
                       Margin="0,8,0,0"
                       Foreground="#A9C4B5"
                       TextWrapping="Wrap"
                       FontSize="14" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20"
                Padding="22"
                Background="{StaticResource PanelBrush}"
                CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Startguthaben"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal">
                    <TextBox x:Name="StartingBankrollInput"
                             Width="150"
                             Height="38"
                             Padding="10,5"
                             VerticalContentAlignment="Center"
                             FontSize="16" />
                    <TextBlock Text="€"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#A9C4B5"
                               FontSize="16" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Margin="0,24,0,0"
                           Text="Anzahl der Decks"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <ComboBox x:Name="DeckCountSelector"
                          Grid.Row="1"
                          Grid.Column="1"
                          Width="220"
                          Height="38"
                          Margin="0,24,0,0"
                          HorizontalAlignment="Left"
                          VerticalContentAlignment="Center"
                          FontSize="15">
                    <ComboBoxItem Content="1 Deck (52 Karten)"
                                  Tag="1" />
                    <ComboBoxItem Content="2 Decks (104 Karten)"
                                  Tag="2" />
                    <ComboBoxItem Content="4 Decks (208 Karten)"
                                  Tag="4" />
                    <ComboBoxItem Content="6 Decks (312 Karten)"
                                  Tag="6" />
                    <ComboBoxItem Content="8 Decks (416 Karten)"
                                  Tag="8" />
                </ComboBox>

                <TextBlock Grid.Row="2"
                           Margin="0,24,0,0"
                           Text="Dealer bei Soft 17"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <ComboBox x:Name="DealerRuleSelector"
                          Grid.Row="2"
                          Grid.Column="1"
                          Width="280"
                          Height="38"
                          Margin="0,24,0,0"
                          HorizontalAlignment="Left"
                          VerticalContentAlignment="Center"
                          FontSize="15">
                    <ComboBoxItem Content="Bleibt stehen (S17)" />
                    <ComboBoxItem Content="Zieht eine Karte (H17)" />
                </ComboBox>

                <Border Grid.Row="3"
                        Grid.ColumnSpan="2"
                        Margin="0,28,0,0"
                        Padding="14"
                        VerticalAlignment="Top"
                        Background="#66152F24"
                        CornerRadius="10">
                    <TextBlock Foreground="#BBD4C6"
                               TextWrapping="Wrap"
                               FontSize="13">
                        <Run Text="Hinweis: " FontWeight="Bold" />
                        <Run Text="Das gespeicherte Guthaben der laufenden Sitzung wird beim Übernehmen auf das neue Startguthaben gesetzt. Deine lebenslange Gesamtstatistik wird nicht gelöscht." />
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Content="Abbrechen"
                    Click="CancelButton_Click" />
            <Button Content="Speichern und neu starten"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
